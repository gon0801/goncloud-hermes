<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.goncloud.vigila-modelos</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@HOME@/goncloud-vigia/scripts/vigila_modelos.py</string>
    <string>--raiz</string>
    <string>@HOME@/goncloud-vigia</string>
    <string>--aviso</string>
    <string>@HOME@/goncloud-vigia/avisos</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/goncloud/vigila-modelos.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/goncloud/vigila-modelos.log</string>
</dict>
</plist>
